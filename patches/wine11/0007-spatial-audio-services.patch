+
+    if (!spatial_stream_supported || !max_dyn_count)
+    {
+        win_skip("Spatial services need a rendering endpoint.\n");
+        return;
+    }
+    hr = ISpatialAudioClient_IsSpatialAudioStreamAvailable(sac, &IID_ISpatialAudioObjectRenderStream, NULL);
+    ok(hr == S_OK, "Expected the base stream to be available, got %#lx.\n", hr);
+    hr = ISpatialAudioClient_IsSpatialAudioStreamAvailable(sac, &IID_IAudioClient, NULL);
+    ok(hr == SPTLAUDCLNT_E_STREAM_NOT_AVAILABLE, "Unexpected unsupported stream result %#lx.\n", hr);
+    fill_activation_params(&params);
+    params.StaticObjectTypeMask = AudioObjectType_FrontLeft | AudioObjectType_FrontRight;
+    params.MaxDynamicObjectCount = min(max_dyn_count, 2);
+    params.MinDynamicObjectCount = params.MaxDynamicObjectCount;
+    PropVariantInit(&activation);
+    activation.vt = VT_BLOB;
+    activation.blob.cbSize = sizeof(params);
+    activation.blob.pBlobData = (BYTE *)&params;
+    hr = ISpatialAudioClient_ActivateSpatialAudioStream(sac, &activation, &IID_ISpatialAudioObjectRenderStream, (void **)&stream);
+    ok(hr == S_OK, "Service stream activation failed %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    hr = ISpatialAudioObjectRenderStream_GetService(stream, &IID_IAudioClock, NULL);
+    ok(hr == E_POINTER, "Expected null output rejection, got %#lx.\n", hr);
+    service = (void *)0xdeadbeef;
+    hr = ISpatialAudioObjectRenderStream_GetService(stream, &IID_IAudioClient, &service);
+    ok(hr == E_NOINTERFACE && !service, "Unknown service must clear output, got %#lx/%p.\n", hr, service);
+    hr = ISpatialAudioObjectRenderStream_GetService(stream, &IID_IAudioClock, (void **)&clock);
+    ok(hr == S_OK && clock, "Clock service failed %#lx.\n", hr);
+    hr = ISpatialAudioObjectRenderStream_GetService(stream, &IID_IAudioClock2, (void **)&clock2);
+    ok(hr == S_OK && clock2, "Clock2 service failed %#lx.\n", hr);
+    hr = ISpatialAudioObjectRenderStream_GetService(stream, &IID_IAudioStreamVolume, (void **)&volume);
+    ok(hr == S_OK && volume, "Volume service failed %#lx.\n", hr);
+    if (!clock || !clock2 || !volume) goto done;
+
+    hr = IAudioClock_QueryInterface(clock, &IID_IAudioClock2, (void **)&other_clock2);
+    ok(hr == S_OK && other_clock2 == clock2, "Clock2 identity mismatch %#lx.\n", hr);
+    if (SUCCEEDED(hr)) IAudioClock2_Release(other_clock2);
+    hr = IAudioClock2_QueryInterface(clock2, &IID_IAudioClock, (void **)&other_clock);
+    ok(hr == S_OK && other_clock == clock, "Clock identity mismatch %#lx.\n", hr);
+    if (SUCCEEDED(hr)) IAudioClock_Release(other_clock);
+    IAudioClock_QueryInterface(clock, &IID_IUnknown, (void **)&unknown);
+    IAudioClock2_QueryInterface(clock2, &IID_IUnknown, (void **)&other_unknown);
+    ok(unknown == other_unknown, "The clocks must have the same controlling unknown.\n");
+    IUnknown_Release(unknown);
+    IUnknown_Release(other_unknown);
+    hr = IAudioClock_GetFrequency(clock, NULL);
+    ok(hr == E_POINTER, "Expected clock pointer validation, got %#lx.\n", hr);
+    hr = IAudioClock_GetPosition(clock, NULL, NULL);
+    ok(hr == E_POINTER, "Expected position pointer validation, got %#lx.\n", hr);
+    hr = IAudioClock2_GetPosition(clock2, NULL, NULL);
+    ok(hr == E_POINTER, "Expected device pointer validation, got %#lx.\n", hr);
+    hr = IAudioClock_GetFrequency(clock, &frequency);
+    ok(hr == S_OK && frequency, "Invalid clock frequency %#lx.\n", hr);
+    hr = IAudioClock_GetCharacteristics(clock, &characteristics);
+    ok(hr == S_OK && characteristics == AUDIOCLOCK_CHARACTERISTIC_FIXED_FREQ, "Invalid clock characteristics %#lx.\n", hr);
+    hr = IAudioClock2_GetPosition(clock2, &device_position, &qpc);
+    ok(hr == AUDCLNT_S_POSITION_STALLED, "Stopped device clock must be stalled, got %#lx.\n", hr);
+
+    hr = IAudioStreamVolume_GetChannelCount(volume, &count);
+    ok(hr == S_OK && count, "Invalid volume channel count %#lx/%u.\n", hr, count);
+    levels = calloc(count, sizeof(*levels));
+    if (!levels) goto done;
+    hr = IAudioStreamVolume_GetAllVolumes(volume, count, levels);
+    ok(hr == S_OK, "GetAllVolumes failed %#lx.\n", hr);
+    for (i = 0; i < count; ++i)
+        ok(levels[i] == 1.0f, "Expected unity channel %u, got %f.\n", i, levels[i]);
+    hr = IAudioStreamVolume_SetChannelVolume(volume, count, 0.5f);
+    ok(hr == E_INVALIDARG, "Invalid channel accepted %#lx.\n", hr);
+    hr = IAudioStreamVolume_SetChannelVolume(volume, 0, NAN);
+    ok(hr == E_INVALIDARG, "NaN volume accepted %#lx.\n", hr);
+    hr = IAudioStreamVolume_SetChannelVolume(volume, 0, INFINITY);
+    ok(hr == E_INVALIDARG, "Infinite volume accepted %#lx.\n", hr);
+    hr = IAudioStreamVolume_SetChannelVolume(volume, 0, -0.5f);
+    ok(hr == E_INVALIDARG, "Negative volume accepted %#lx.\n", hr);
+    hr = IAudioStreamVolume_SetChannelVolume(volume, 0, 1.5f);
+    ok(hr == E_INVALIDARG, "Excess volume accepted %#lx.\n", hr);
+    hr = IAudioStreamVolume_SetAllVolumes(volume, count, NULL);
+    ok(hr == E_POINTER, "Null volumes accepted %#lx.\n", hr);
+    hr = IAudioStreamVolume_GetAllVolumes(volume, count - 1, levels);
+    ok(hr == E_INVALIDARG, "Wrong volume count accepted %#lx.\n", hr);
+    for (i = 0; i < count; ++i) levels[i] = 0.5f;
+    levels[count - 1] = NAN;
+    hr = IAudioStreamVolume_SetAllVolumes(volume, count, levels);
+    ok(hr == E_INVALIDARG, "Invalid batch accepted %#lx.\n", hr);
+    hr = IAudioStreamVolume_GetChannelVolume(volume, 0, &level);
+    ok(hr == S_OK && level == 1.0f, "Invalid batch changed earlier channels: %#lx/%f.\n", hr, level);
+    levels[count - 1] = 0.5f;
+    hr = IAudioStreamVolume_SetAllVolumes(volume, count, levels);
+    ok(hr == S_OK, "Valid volume batch failed %#lx.\n", hr);
+    hr = IAudioStreamVolume_SetChannelVolume(volume, 0, 0.25f);
+    ok(hr == S_OK, "Channel setter failed %#lx.\n", hr);
+    hr = IAudioStreamVolume_GetAllVolumes(volume, count, levels);
+    ok(hr == S_OK && levels[0] == 0.25f, "Volume round trip failed %#lx.\n", hr);
+    for (i = 1; i < count; ++i) ok(levels[i] == 0.5f, "Unexpected channel %u volume %f.\n", i, levels[i]);
+
+    hr = ISpatialAudioObjectRenderStream_Start(stream);
+    ok(hr == S_OK, "Start failed %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    for (i = 0; i < 8; ++i)
+    {
+        hr = WaitForSingleObject(event, 1000);
+        ok(hr == WAIT_OBJECT_0, "Service update timeout %u.\n", i);
+        if (hr != WAIT_OBJECT_0) break;
+        hr = ISpatialAudioObjectRenderStream_BeginUpdatingAudioObjects(stream, &available, &frames);
+        ok(hr == S_OK, "Begin failed %#lx.\n", hr);
+        if (FAILED(hr)) break;
+        if (!object)
+        {
+            hr = ISpatialAudioObjectRenderStream_ActivateSpatialAudioObject(stream, AudioObjectType_Dynamic, &object);
+            ok(hr == S_OK, "Object activation failed %#lx.\n", hr);
+        }
+        if (object)
+        {
+            hr = ISpatialAudioObject_GetBuffer(object, &buffer, &bytes);
+            ok(hr == S_OK, "Buffer failed %#lx.\n", hr);
+            if (SUCCEEDED(hr)) memset(buffer, 0, bytes);
+        }
+        hr = ISpatialAudioObjectRenderStream_EndUpdatingAudioObjects(stream);
+        ok(hr == S_OK, "End failed %#lx.\n", hr);
+    }
+    Sleep(20);
+    hr = IAudioClock_GetPosition(clock, &position, &qpc);
+    ok(hr == S_OK && position && qpc, "Stream clock did not advance %#lx.\n", hr);
+    ok(position <= frequency, "Unexpected stream duration %s/%s.\n", wine_dbgstr_longlong(position), wine_dbgstr_longlong(frequency));
+    hr = IAudioClock2_GetPosition(clock2, &device_position, &qpc);
+    ok(hr == S_OK && qpc, "Device clock failed %#lx.\n", hr);
+    Sleep(20);
+    hr = IAudioClock2_GetPosition(clock2, &later, NULL);
+    ok(hr == S_OK && later >= device_position, "Device clock regressed %#lx.\n", hr);
+    hr = ISpatialAudioObjectRenderStream_Stop(stream);
+    ok(hr == S_OK, "Stop failed %#lx.\n", hr);
+    hr = IAudioClock_GetPosition(clock, &position, NULL);
+    ok(hr == S_OK, "Stopped stream clock failed %#lx.\n", hr);
+    Sleep(20);
+    hr = IAudioClock_GetPosition(clock, &later, NULL);
+    ok(hr == S_OK && later == position, "Stopped stream clock advanced %#lx.\n", hr);
+    hr = ISpatialAudioObjectRenderStream_Reset(stream);
+    ok(hr == S_OK, "Reset failed %#lx.\n", hr);
+    if (object) { ISpatialAudioObject_Release(object); object = NULL; }
+    ISpatialAudioObjectRenderStream_Release(stream);
+    stream = NULL;
+    hr = IAudioClock_GetPosition(clock, &position, NULL);
+    ok(hr == S_OK && !position, "Service did not retain reset stream %#lx.\n", hr);
+    hr = IAudioStreamVolume_GetChannelVolume(volume, 0, &level);
+    ok(hr == S_OK && level == 0.25f, "Volume did not retain stream %#lx/%f.\n", hr, level);
+
+done:
+    free(levels);
+    if (object) ISpatialAudioObject_Release(object);
+    if (volume) IAudioStreamVolume_Release(volume);
+    if (clock2) IAudioClock2_Release(clock2);
+    if (clock) IAudioClock_Release(clock);
+    if (stream) ISpatialAudioObjectRenderStream_Release(stream);
+}
