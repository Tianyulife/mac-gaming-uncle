+
+static HRESULT WINAPI spatial_volume_GetChannelVolume(IAudioStreamVolume *iface, UINT32 index, float *level)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioStreamVolume_iface);
+    IAudioStreamVolume *backend;
+    HRESULT hr;
+    if (!level) return E_POINTER;
+    if (index >= stream->stream_fmtex.Format.nChannels) return E_INVALIDARG;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioStreamVolume, (void **)&backend))) return hr;
+    hr = IAudioStreamVolume_GetChannelVolume(backend, index, level);
+    IAudioStreamVolume_Release(backend);
+    return hr;
+}
+
+static HRESULT WINAPI spatial_volume_SetChannelVolume(IAudioStreamVolume *iface, UINT32 index, float level)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioStreamVolume_iface);
+    IAudioStreamVolume *backend;
+    HRESULT hr;
+    if (index >= stream->stream_fmtex.Format.nChannels || !isfinite(level) || level < 0.0f || level > 1.0f) return E_INVALIDARG;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioStreamVolume, (void **)&backend))) return hr;
+    hr = IAudioStreamVolume_SetChannelVolume(backend, index, level);
+    IAudioStreamVolume_Release(backend);
+    return hr;
+}
+
+static HRESULT WINAPI spatial_volume_GetAllVolumes(IAudioStreamVolume *iface, UINT32 count, float *levels)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioStreamVolume_iface);
+    IAudioStreamVolume *backend;
+    HRESULT hr;
+    if (!levels) return E_POINTER;
+    if (count != stream->stream_fmtex.Format.nChannels) return E_INVALIDARG;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioStreamVolume, (void **)&backend))) return hr;
+    hr = IAudioStreamVolume_GetAllVolumes(backend, count, levels);
+    IAudioStreamVolume_Release(backend);
+    return hr;
+}
+
+static HRESULT WINAPI spatial_volume_SetAllVolumes(IAudioStreamVolume *iface, UINT32 count, const float *levels)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioStreamVolume_iface);
+    IAudioStreamVolume *backend;
+    HRESULT hr;
+    UINT32 i;
+
+    if (!levels) return E_POINTER;
+    if (count != stream->stream_fmtex.Format.nChannels) return E_INVALIDARG;
+    for (i = 0; i < count; ++i)
+        if (!isfinite(levels[i]) || levels[i] < 0.0f || levels[i] > 1.0f) return E_INVALIDARG;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioStreamVolume, (void **)&backend))) return hr;
+    hr = IAudioStreamVolume_SetAllVolumes(backend, count, levels);
+    IAudioStreamVolume_Release(backend);
+    return hr;
+}
