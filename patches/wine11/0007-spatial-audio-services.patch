+/* Service references retain the spatial stream, including its renderer and
+ * endpoint-loss state, rather than returning the private audio client. */
+static HRESULT spatial_service_backend(SpatialAudioStreamImpl *stream, REFIID iid, void **out)
+{
+    BOOL notify;
+    HRESULT hr;
+
+    *out = NULL;
+    EnterCriticalSection(&stream->lock);
+    notify = poll_stream_invalidation_locked(stream);
+    hr = stream->invalidation_hr;
+    if (SUCCEEDED(hr))
+        hr = IAudioClient_GetService(stream->client, iid, out);
+    LeaveCriticalSection(&stream->lock);
+    if (notify)
+        notify_dynamic_capacity_lost(stream);
+    return hr;
+}
+
+static HRESULT WINAPI spatial_clock_QueryInterface(IAudioClock *iface, REFIID iid, void **out)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioClock_iface);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IAudioClock))
+        *out = iface;
+    else if (IsEqualIID(iid, &IID_IAudioClock2))
+        *out = &stream->IAudioClock2_iface;
+    else
+        return E_NOINTERFACE;
+    SAORS_AddRef(&stream->ISpatialAudioObjectRenderStream_iface);
+    return S_OK;
+}
+
+static ULONG WINAPI spatial_clock_AddRef(IAudioClock *iface)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioClock_iface);
+    return SAORS_AddRef(&stream->ISpatialAudioObjectRenderStream_iface);
+}
+
+static ULONG WINAPI spatial_clock_Release(IAudioClock *iface)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioClock_iface);
+    return SAORS_Release(&stream->ISpatialAudioObjectRenderStream_iface);
+}
+
+static HRESULT WINAPI spatial_clock_GetFrequency(IAudioClock *iface, UINT64 *value)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioClock_iface);
+    IAudioClock *backend;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioClock, (void **)&backend))) return hr;
+    hr = IAudioClock_GetFrequency(backend, value);
+    IAudioClock_Release(backend);
+    return hr;
+}
+
+static HRESULT WINAPI spatial_clock_GetPosition(IAudioClock *iface, UINT64 *value, UINT64 *qpc)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioClock_iface);
+    IAudioClock *backend;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioClock, (void **)&backend))) return hr;
+    hr = IAudioClock_GetPosition(backend, value, qpc);
+    IAudioClock_Release(backend);
+    return hr;
+}
+
+static HRESULT WINAPI spatial_clock_GetCharacteristics(IAudioClock *iface, DWORD *value)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioClock_iface);
+    IAudioClock *backend;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioClock, (void **)&backend))) return hr;
+    hr = IAudioClock_GetCharacteristics(backend, value);
+    IAudioClock_Release(backend);
+    return hr;
+}
