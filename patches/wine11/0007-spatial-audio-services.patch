+static HRESULT WINAPI spatial_clock2_GetDevicePosition(IAudioClock2 *iface, UINT64 *position, UINT64 *qpc)
+{
+    SpatialAudioStreamImpl *stream = CONTAINING_RECORD(iface, SpatialAudioStreamImpl, IAudioClock2_iface);
+    IAudioClock *clock;
+    IAudioClock2 *backend;
+    HRESULT hr;
+
+    if (!position) return E_POINTER;
+    if (FAILED(hr = spatial_service_backend(stream, &IID_IAudioClock, (void **)&clock))) return hr;
+    hr = IAudioClock_QueryInterface(clock, &IID_IAudioClock2, (void **)&backend);
+    IAudioClock_Release(clock);
