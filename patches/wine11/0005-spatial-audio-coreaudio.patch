+static UINT32 spatial_generation_hash(UINT32 hash, const void *data, size_t size)
+{
+    const BYTE *bytes = data;
+
+    while (size--)
+    {
+        hash ^= *bytes++;
+        hash *= 16777619u;
+    }
+    return hash;
+}
